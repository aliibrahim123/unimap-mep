import cpu.common { invalid, regs, pc, write_reg, dec_2reg, dec_3reg, dec_1reg, s12_imd, s19_imd };
import cpu.mem { 
	read_mem_8, read_mem_16, read_mem_32, read_mem_64, 
	write_mem_8, write_mem_16, write_mem_32, write_mem_64 
};
import math.nb { b0, low2, high2, n8_nb, n16_nb, n32_nb };
import math.shift { shift_l1, sign_ext8, sign_ext16, sign_ext32 };
import math.arith { add };

fn exec_mem (inst, state) => low2(inst[1]): {
	// op.size reg, [base:reg + offset:s12_imd]
	0 => exec_imd(inst, state, 0),
	// op.size reg, [base:reg += offset:s12_imd]
	1 => exec_imd(inst, state, 1),
	// ld{, .32, .16, .8} reg, [offset:s19_imd]
	3 => exec_rel(inst, state),
	2 => high2(inst[1]): {
		0 => inst[2]: {
			// op.size reg, [base:reg + index:reg << (0 | (3-sz)]
			0 => exec_index(inst, state),
			_ => invalid(state, inst),
		},
		_ => invalid(state, inst),
	},
};

fn access_mem (state, inst, reg, address, op, size) => op: {
	0 => size: {
		// ld 
		0 => read_mem_64(state, address),
		// ld.32
		1 => read_mem_32(state, address) |> n32_nb(_),
		// ld.16
		2 => read_mem_16(state, address) |> n16_nb(_),
		// ld.8
		3 => read_mem_8(state, address) |> n8_nb(_),
	} |> write_reg(state, reg, _),
	1 => state.regs[reg] |> size: {
		// st
		0 => write_mem_64(state, address, _),
		// st.32
		1 => write_mem_32(state, address, _),
		// st.16
		2 => write_mem_16(state, address, _),
		// st.8
		3 => write_mem_8(state, address, _),
	},
	2 => size: {
		0 => invalid(state, inst),
		// ld.s32
		1 => read_mem_32(state, address) |> sign_ext32(_),
		// ld.s16
		2 => read_mem_16(state, address) |> sign_ext16(_),
		// ld.s8
		3 => read_mem_8(state, address)  |> sign_ext8(_),
	} |> write_reg(state, reg, _),
	3 => invalid(state, inst),
};

fn exec_imd (inst, state, writeback) =>[dec_2reg(inst[2], inst[3], inst[4]), s12_imd(inst)]: {
	[[let reg, let base], let imd] => cal_adress(state.regs[base], imd, low2(inst[2])): {
		let address => access_mem(state, inst, reg, address, high2(inst[1]), low2(inst[2]))
		|> writeback: {
			0 => _,
			1 => write_reg(_, base, address)
		}
	}
};

fn exec_index (inst, state) => dec_3reg(inst[4], inst[5], inst[6], inst[7]): {
	[let reg, let base, let index] => cal_adress(state.regs[base], state.regs[index], 
		b0(inst[4]): { 0 => 0, 1 => high2(inst[3]) }
	) |> access_mem(state, inst, reg, _, low2(inst[3]), high2(inst[3]))
};

fn exec_rel (inst, state) => cal_adress(state.pc, s19_imd(inst), high2(inst[1])) 
	|> high2(inst[1]): {
		0 => read_mem_64(state, _),
		1 => read_mem_32(state, _) |> n32_nb(_),
		2 => read_mem_16(state, _) |> n16_nb(_),
		3 => read_mem_8(state, _) |> n8_nb(_),
	} 
	|> write_reg(state, dec_1reg(inst[6], inst[7]), _);

fn cal_adress (base, offset, size) => size: {
	0 => add(base, offset),
	_ => add(base, shift_l1(offset, 0, size: { 0 => 2, 1 => 2, 2 => 1, 3 => 0 })),
};