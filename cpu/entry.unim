import cpu.common { regs, pc, mem, c0, invalid };
import cpu.dpr { exec_dpr };
import cpu.dpi { exec_dpi };
import cpu.mem_ops { exec_mem };
import cpu.branch { exec_branch, branched, halted, next_address };
import cpu.mem { read_mem_32 };
import math.nb { zero };
import math.comp { eq };
import math.arith { add };
symbol continue, end;

let init_state = {
	regs = { 
		0  = zero, 1  = zero, 2  = zero, 3  = zero, 4  = zero, 5  = zero, 6  = zero, 7  = zero, 
		8  = zero, 9  = zero, 10 = zero, 11 = zero, 12 = zero, 13 = zero, 14 = zero, 15 = zero, 
		16 = zero, 17 = zero, 18 = zero, 19 = zero, 20 = zero, 21 = zero, 22 = zero, 23 = zero, 
		24 = zero, 25 = zero, 26 = zero, 27 = zero, 28 = zero, 29 = zero, 30 = zero, 31 = zero
	},
	pc = zero,
	c0 = 0,
	mem = {},
};
fn run_iter (state) => exec(read_mem_32(state, state.pc), state): {
	[branched, let state] => [continue, state],
	[halted, let state] => [end, state],
	let state => [continue, { ..state, pc = next_address(state) }],
};

fn exec (inst, state) => inst[0]: {
	1 => exec_dpr(inst, state),
	2 => exec_dpi(inst, state),
	3 => exec_mem(inst, state),
	4 => exec_branch(inst, state),
	_ => invalid(state, inst),
};