import cpu.common { mem, panic, pc };
import math.nb { zero128 };

// memory is 7 level table, sparse, with 16 byte per line and 16 subpage per page
// address used is 32 bit, compossed into 8 4 bit sections

fn read_mem_line (state, address) => state.mem: {
  { [address[7]]: let page0 } => page0: {
	{ [address[6]]: let page1 } => page1: {
	  { [address[5]]: let page2 } => page2: {
		{ [address[4]]: let page3 } => page3: {
		  { [address[3]]: let page4 } => page4: {
			{ [address[2]]: let page5 } => page5: {
			  { [address[1]]: let line } => line,
			  _ => zero128
			},
			_ => zero128
		  },
		  _ => zero128
		},
		_ => zero128
	  },
	  _ => zero128
	},
	_ => zero128
  },
  _ => zero128
};

symbol unaligned_address;
fn read_mem_64 (state, address) => read_mem_line(state, address) |> address[0]: {
	0 => [
		_[ 0], _[ 1], _[ 2], _[ 3], _[ 4], _[ 5], _[ 6], _[ 7],  
		_[ 8], _[ 9], _[10], _[11], _[12], _[13], _[14], _[15]
	],
	8 => [
		_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23], 
		_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31]
	], 
	_ => dbg([unaligned_address, state.pc, address]) |> panic()
};
fn read_mem_32 (state, address) => read_mem_line(state, address) |> address[0]: {
	0  => [_[ 0], _[ 1], _[ 2], _[ 3], _[ 4], _[ 5], _[ 6], _[ 7]],
	4  => [_[ 8], _[ 9], _[10], _[11], _[12], _[13], _[14], _[15]],
	8  => [_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23]],
	12 => [_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31]],
	_  => dbg([unaligned_address, state.pc, address]) |> panic(),
};
fn read_mem_16 (state, address) => read_mem_line(state, address) |> address[0]: {
	0  => [_[ 0], _[ 1], _[ 2], _[ 3]],
	2  => [_[ 4], _[ 5], _[ 6], _[ 7]],
	4  => [_[ 8], _[ 9], _[10], _[11]],
	6  => [_[12], _[13], _[14], _[15]],
	8  => [_[16], _[17], _[18], _[19]],
	10 => [_[20], _[21], _[22], _[23]],
	12 => [_[24], _[25], _[26], _[27]],
	14 => [_[28], _[29], _[30], _[31]],
	_ => dbg([unaligned_address, state.pc, address]) |> panic(),
};
fn read_mem_8 (state, address) => read_mem_line(state, address) |> address[0]: {
	0  => [_[ 0], _[1]],
	1  => [_[ 2], _[3]],
	2  => [_[ 4], _[5]],
	3  => [_[ 6], _[7]],
	4  => [_[ 8], _[9]],
	5  => [_[10], _[11]],
	6  => [_[12], _[13]],
	7  => [_[14], _[15]],
	8  => [_[16], _[17]],
	9  => [_[18], _[19]],
	10 => [_[20], _[21]],
	11 => [_[22], _[23]],
	12 => [_[24], _[25]],
	13 => [_[26], _[27]],
	14 => [_[28], _[29]],
	15 => [_[30], _[31]],
};

fn safe_read (obj, field) => obj: { { [field]: let val } => val, _ => {} };
fn write_mem_line (state, address, line) => { ..state, mem = {
  ..state.mem, [address[7]] = safe_read(state.mem, address[7]) |> { 
	.._, [address[6]] = safe_read(_, address[6]) |> { 
	  .._, [address[5]] = safe_read(_, address[5]) |> { 
		.._, [address[4]] = safe_read(_, address[4]) |> {
		  .._, [address[3]] = safe_read(_, address[3]) |> { 
			.._, [address[2]] = safe_read(_, address[2]) |> { 
			  .._, [address[1]] = line
			}
		  }
		}
	  }
	}
  }
} };

fn write_mem_64 (state, address, value) => read_mem_line(state, address) |> address[0]: {
	0 => [
		value[0], value[1], value[2], value[3], value[4], value[5], value[6], value[7],
		value[8], value[9], value[10], value[11], value[12], value[13], value[14], value[15],
		_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23],
		_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31],
	],
	8 => [
		_[0], _[1], _[2], _[3], _[4], _[5], _[6], _[7],
		_[8], _[9], _[10], _[11], _[12], _[13], _[14], _[15],
		value[0], value[1], value[2], value[3], value[4], value[5], value[6], value[7],
		value[8], value[9], value[10], value[11], value[12], value[13], value[14], value[15],
	],
	_ => dbg([unaligned_address, state.pc, address]) |> panic(),
} |> write_mem_line(state, address, _);
fn write_mem_32 (state, address, value) => read_mem_line(state, address) |> address[0]: {
	0 => [
		value[0], value[1], value[2], value[3], value[4], value[5], value[6], value[7],
		_[8], _[9], _[10], _[11], _[12], _[13], _[14], _[15],
		_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23],
		_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31],
	],
	4 => [
		_[0], _[1], _[2], _[3], _[4], _[5], _[6], _[7],
		value[0], value[1], value[2], value[3], value[4], value[5], value[6], value[7],
		_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23],
		_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31],
	],
	8 => [
		_[0], _[1], _[2], _[3], _[4], _[5], _[6], _[7],
		_[8], _[9], _[10], _[11], _[12], _[13], _[14], _[15],
		value[0], value[1], value[2], value[3], value[4], value[5], value[6], value[7],
		_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31],
	],
	12 => [
		_[0], _[1], _[2], _[3], _[4], _[5], _[6], _[7],
		_[8], _[9], _[10], _[11], _[12], _[13], _[14], _[15],
		_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23],
		value[0], value[1], value[2], value[3], value[4], value[5], value[6], value[7],	
	],
	_ => dbg([unaligned_address, state.pc, address]) |> panic(),
} |> write_mem_line(state, address, _);
fn write_mem_16 (state, address, value) => read_mem_line(state, address) |> address[0]: {
	0 => [
		value[0], value[1], value[2], value[3], _[4], _[5], _[6], _[7],
		_[8], _[9], _[10], _[11], _[12], _[13], _[14], _[15],
		_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23],
		_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31],
	],
	2 => [
		_[0], _[1], _[2], _[3], value[0], value[1], value[2], value[3],
		_[8], _[9], _[10], _[11], _[12], _[13], _[14], _[15],
		_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23],
		_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31],
	],
	4 => [
		_[0], _[1], _[2], _[3], _[4], _[5], _[6], _[7],
		value[0], value[1], value[2], value[3], _[12], _[13], _[14], _[15],
		_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23],
		_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31],
	],
	6 => [
		_[0], _[1], _[2], _[3], _[4], _[5], _[6], _[7],
		_[8], _[9], _[10], _[11], value[0], value[1], value[2], value[3],
		_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23],
		_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31],
	],
	8 => [
		_[0], _[1], _[2], _[3], _[4], _[5], _[6], _[7],
		_[8], _[9], _[10], _[11], _[12], _[13], _[14], _[15],
		value[0], value[1], value[2], value[3], _[20], _[21], _[22], _[23],
		_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31],
	],
	10 => [
		_[0], _[1], _[2], _[3], _[4], _[5], _[6], _[7],
		_[8], _[9], _[10], _[11], _[12], _[13], _[14], _[15],
		_[16], _[17], _[18], _[19], value[0], value[1], value[2], value[3],
		_[24], _[25], _[26], _[27], _[28], _[29], _[30], _[31],
	],
	12 => [
		_[0], _[1], _[2], _[3], _[4], _[5], _[6], _[7],
		_[8], _[9], _[10], _[11], _[12], _[13], _[14], _[15],
		_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23],
		value[0], value[1], value[2], value[3], _[28], _[29], _[30], _[31],
	],
	14 => [
		_[0], _[1], _[2], _[3], _[4], _[5], _[6], _[7],
		_[8], _[9], _[10], _[11], _[12], _[13], _[14], _[15],
		_[16], _[17], _[18], _[19], _[20], _[21], _[22], _[23],
		_[24], _[25], _[26], _[27], value[0], value[1], value[2], value[3],	
	],
	_ => dbg([unaligned_address, state.pc, address]) |> panic(),
} |> write_mem_line(state, address, _);
fn write_mem_8 (state, address, value) => read_mem_line(state, address) |> address[0]: {
	0 => [
		value[0], value[1], _[2], _[3], _[4], _[5], _[6], _[7],
		_[8], _[9], _[10], _[11], _[12], _[13], _[14], _[15],
