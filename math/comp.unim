import math.nb { zero, b3 };
import math.arith { sub, sub_borrow };
symbol pos, neg;

fn sign (nb) => b3(nb[15]): { 0 => pos, 1 => neg };

fn eq (a, b) => a: { b => 1, _ => 0 };
fn ne (a, b) => a: { b => 0, _ => 1 };

fn comp (a, b) => sub(a, b): {
	zero => 0,
	let diff => eq(sign(a), sign(b)): {
		// same sign, compare through difference sign
		1 => sign(diff): { pos => 1, neg => 2 },
		// different sign overflows difference, compare through sign
		0 => sign(a): { pos => 1, neg => 2 }
	}
};
fn ucomp (a, b) => sub_borrow(a, b, 0): {
	[zero, _] => 0,
	// div > 0
	[_, 0] => 1,
	_ => 2,
};

fn min (a, b) => comp(a, b): { 1 => b, _ => a };
fn max (a, b) => comp(a, b): { 1 => a, _ => b };
fn umin (a, b) => ucomp(a, b): { 1 => b, _ => a };
fn umax (a, b) => ucomp(a, b): { 1 => a, _ => b };

fn sign_ext8 (nb) => b3(nb[1]): {
	0 => nb,
	_ => [nb[0], nb[1], 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15],
};
fn sign_ext16 (nb) => b3(nb[3]): {
	0 => nb,
	_ => [nb[0], nb[1], nb[2], nb[3], 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15],
};
fn sign_ext32 (nb) => b3(nb[7]): {
	0 => nb,
	_ => [nb[0], nb[1], nb[2], nb[3], nb[4], nb[5], nb[6], nb[7], 15, 15, 15, 15, 15, 15, 15, 15],
};